import "org.gluon.Types" as types

/// Test interface
interface Test {
	quit()

	ping() -> ()

	echo(input: TestEnum) -> (output: TestEnum)

	echo_ref(input: Ref<Test>) -> (output: Ref<Test>)

	echo_untyped_ref(input: Ref) -> (output: Ref)

	get_position() -> (position: types::Vec3)
}

/// test struct
struct TestStruct {
	string: String,
	id: u64,
	binder_ref: Ref<Test>,
	position: types::Vec3,
}

/// test struct
struct FdTestStruct {
	fd1: Fd,
	fd2: Fd,
	fd3: Fd,
	fds: Vec<Fd>,
}

/// Test enum
enum TestEnum {
	TestStruct {
		test_struct: TestStruct,
	},
	Fd {
		fd: Fd,
	},
	EmptyVariant
}

/// Simple unit-variant enum used to test proxy propagation into struct fields
enum Color {
	Red,
	Green,
	Blue,
}

/// Struct whose fields use Color — exercises the proxy-in-struct-field path
struct Palette {
	primary: Color,
	secondary: Color,
}

/// Struct with an optional Color — exercises proxy inside Option
struct MaybeColor {
	color: Option<Color>,
}

/// Every primitive once, so each one's codegen gets compiled and round tripped
struct TypesTest {
	flag: bool,
	byte: u8,
	ushort: u16,
	uint: u32,
	ulong: u64,
	sbyte: i8,
	short: i16,
	int: i32,
	long: i64,
	float: f32,
	double: f64,
	string: String,
}

/// Enum with data in its variants, for reading into a variant that's already there
enum Shape {
	Circle {
		radius: f32,
	},
	Named {
		name: String,
	},
	Empty,
}
